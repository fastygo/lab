{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lab.fastygo.dev/schemas/finding.schema.json",
  "title": "Finding",
  "type": "object",
  "required": ["code", "gate", "check", "severity", "message"],
  "properties": {
    "code": { "type": "string" },
    "gate": { "type": "string" },
    "check": { "type": "string" },
    "severity": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low", "info"]
    },
    "message": { "type": "string" },
    "evidence": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "target": { "type": "string" }
  }
}
