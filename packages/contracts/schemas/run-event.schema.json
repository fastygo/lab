{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lab.fastygo.dev/schemas/run-event.schema.json",
  "title": "RunEvent",
  "type": "object",
  "required": ["type", "ts"],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "run.started",
        "adapter.ready",
        "gate.started",
        "check.started",
        "check.finished",
        "gate.finished",
        "run.finished",
        "run.failed"
      ]
    },
    "ts": { "type": "string", "format": "date-time" },
    "lab": { "type": "string" },
    "runId": { "type": "string" },
    "gate": { "type": "string" },
    "check": { "type": "string" },
    "runner": { "type": "string" },
    "adapter": { "type": "string" },
    "baseUrl": { "type": "string" },
    "status": { "type": "string", "enum": ["pass", "warn", "fail"] },
    "error": { "type": "string" },
    "payload": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  },
  "additionalProperties": false
}
