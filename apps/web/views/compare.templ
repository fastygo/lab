package views

import (
	uiutils "github.com/ui8kit/ui/utils"
	"github.com/ui8kit/ui/ui/box"
	"github.com/ui8kit/ui/ui/card"
	"github.com/ui8kit/ui/ui/grid"
	"github.com/ui8kit/ui/ui/group"
	"github.com/ui8kit/ui/ui/link"
	"github.com/ui8kit/ui/ui/stack"
	"github.com/ui8kit/ui/ui/text"
	"github.com/ui8kit/ui/ui/title"
)

templ ComparePage(p ComparePageProps) {
	@Layout("Compare") {
		@Shell(p.APIBase) {
			@stack.Stack(stack.StackProps{Class: "gap-6"}) {
				@group.Group(group.GroupProps{Class: "items-center gap-3"}) {
					@link.Link(link.LinkProps{Href: "/", Variant: "default"}) {
						← runs
					}
					@title.Title(title.TitleProps{As: uiutils.H2, Class: "text-lg font-semibold"}) {
						Compare runs
					}
				}
				@card.Card(card.CardProps{Variant: "default"}) {
					@card.CardContent(card.CardContentProps{Class: "p-4"}) {
						<form method="get" action="/compare" class="flex flex-wrap items-end gap-4">
							<div class="flex flex-col gap-1">
								<label class="text-xs text-muted-foreground" for="base">Base</label>
								<select id="base" name="base" class="rounded-md border border-input bg-background px-3 py-2 text-sm">
									<option value="">—</option>
									for _, run := range p.Runs {
										if run.ID == p.BaseID {
											<option value={ run.ID } selected>{ ShortID(run.ID) } · { run.Lab } · { run.Status }</option>
										} else {
											<option value={ run.ID }>{ ShortID(run.ID) } · { run.Lab } · { run.Status }</option>
										}
									}
								</select>
							</div>
							<div class="flex flex-col gap-1">
								<label class="text-xs text-muted-foreground" for="head">Head</label>
								<select id="head" name="head" class="rounded-md border border-input bg-background px-3 py-2 text-sm">
									<option value="">—</option>
									for _, run := range p.Runs {
										if run.ID == p.HeadID {
											<option value={ run.ID } selected>{ ShortID(run.ID) } · { run.Lab } · { run.Status }</option>
										} else {
											<option value={ run.ID }>{ ShortID(run.ID) } · { run.Lab } · { run.Status }</option>
										}
									}
								</select>
							</div>
							<button type="submit" class="rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground">Compare</button>
						</form>
					}
				}
				if p.Err != "" {
					@box.Box(box.BoxProps{Class: "rounded-lg border border-destructive bg-destructive/10 p-4 text-sm text-destructive"}) {
						{ p.Err }
					}
				}
				if p.Diff != nil {
					@grid.Grid(grid.GridProps{Cols: "1-3", Class: "gap-4"}) {
						@card.Card(card.CardProps{Variant: "muted"}) {
							@card.CardHeader(card.CardHeaderProps{}) {
								@card.CardTitle(card.CardTitleProps{}) {
									Status
								}
							}
							@card.CardContent(card.CardContentProps{}) {
								@text.Text(text.TextProps{Class: "text-sm"}) {
									{ p.Diff.BaseStatus } → { p.Diff.HeadStatus }
								}
							}
						}
						@card.Card(card.CardProps{Variant: "muted"}) {
							@card.CardHeader(card.CardHeaderProps{}) {
								@card.CardTitle(card.CardTitleProps{}) {
									High
								}
							}
							@card.CardContent(card.CardContentProps{}) {
								@text.Text(text.TextProps{Class: "text-lg font-semibold"}) {
									{ FormatInt(p.Diff.BaseSummary.High) } → { FormatInt(p.Diff.HeadSummary.High) }
								}
							}
						}
						@card.Card(card.CardProps{Variant: "muted"}) {
							@card.CardHeader(card.CardHeaderProps{}) {
								@card.CardTitle(card.CardTitleProps{}) {
									Delta
								}
							}
							@card.CardContent(card.CardContentProps{}) {
								@text.Text(text.TextProps{Class: "text-sm"}) {
									+{ FormatInt(len(p.Diff.Added)) } / −{ FormatInt(len(p.Diff.Removed)) } / ~{ FormatInt(len(p.Diff.Changed)) }
								}
							}
						}
					}
					if len(p.Diff.Added) > 0 {
						@card.Card(card.CardProps{Variant: "default"}) {
							@card.CardHeader(card.CardHeaderProps{}) {
								@card.CardTitle(card.CardTitleProps{}) {
									Added in head
								}
							}
							@card.CardContent(card.CardContentProps{}) {
								@stack.Stack(stack.StackProps{Class: "gap-2"}) {
									for _, f := range p.Diff.Added {
										@text.Text(text.TextProps{Class: "text-sm font-mono"}) {
											{ string(f.Severity) } · { f.Code } — { f.Message }
										}
									}
								}
							}
						}
					}
					if len(p.Diff.Removed) > 0 {
						@card.Card(card.CardProps{Variant: "default"}) {
							@card.CardHeader(card.CardHeaderProps{}) {
								@card.CardTitle(card.CardTitleProps{}) {
									Removed since base
								}
							}
							@card.CardContent(card.CardContentProps{}) {
								@stack.Stack(stack.StackProps{Class: "gap-2"}) {
									for _, f := range p.Diff.Removed {
										@text.Text(text.TextProps{Class: "text-sm font-mono"}) {
											{ string(f.Severity) } · { f.Code } — { f.Message }
										}
									}
								}
							}
						}
					}
					if len(p.Diff.Changed) > 0 {
						@card.Card(card.CardProps{Variant: "default"}) {
							@card.CardHeader(card.CardHeaderProps{}) {
								@card.CardTitle(card.CardTitleProps{}) {
									Changed
								}
							}
							@card.CardContent(card.CardContentProps{}) {
								@stack.Stack(stack.StackProps{Class: "gap-2"}) {
									for _, c := range p.Diff.Changed {
										@text.Text(text.TextProps{Class: "text-sm font-mono"}) {
											{ c.Base.Code }: { string(c.Base.Severity) } → { string(c.Head.Severity) }
										}
									}
								}
							}
						}
					}
					@link.Link(link.LinkProps{Href: p.APIBase + "/v1/runs/compare?base=" + p.BaseID + "&head=" + p.HeadID + "&format=md", Variant: "default", Class: "text-sm"}) {
						Download compare Markdown
					}
				}
			}
		}
	}
}
