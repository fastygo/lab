package views

import (
	"github.com/ui8kit/ui/ui/box"
	"github.com/ui8kit/ui/ui/link"
	"github.com/ui8kit/ui/ui/text"
)

templ ComparePage(p ComparePageProps) {
	@Layout("Compare") {
		@Shell(p.APIBase, "compare") {
			<div class="lab-hero">
				<div>
					<p class="lab-kicker">Regression</p>
					<h1 class="lab-run-title">Compare runs</h1>
					@text.Text(text.TextProps{Class: "mt-2 text-sm text-muted-foreground"}) {
						Diff non-info findings between a base and a head job.
					}
				</div>
			</div>
			<div class="lab-panel mb-6">
				<div class="lab-panel-head">
					<h2>Select runs</h2>
				</div>
				<div class="lab-panel-body">
					<form method="get" action="/compare" class="flex flex-wrap items-end gap-4">
						<div class="flex flex-col gap-1 min-w-[14rem] grow">
							<label class="text-xs text-muted-foreground" for="base">Base</label>
							<select id="base" name="base" class="rounded-md border border-input bg-background px-3 py-2 text-sm w-full">
								<option value="">—</option>
								for _, run := range p.Runs {
									if run.ID == p.BaseID {
										<option value={ run.ID } selected>{ ShortID(run.ID) } · { run.Lab } · { run.Status }</option>
									} else {
										<option value={ run.ID }>{ ShortID(run.ID) } · { run.Lab } · { run.Status }</option>
									}
								}
							</select>
						</div>
						<div class="flex flex-col gap-1 min-w-[14rem] grow">
							<label class="text-xs text-muted-foreground" for="head">Head</label>
							<select id="head" name="head" class="rounded-md border border-input bg-background px-3 py-2 text-sm w-full">
								<option value="">—</option>
								for _, run := range p.Runs {
									if run.ID == p.HeadID {
										<option value={ run.ID } selected>{ ShortID(run.ID) } · { run.Lab } · { run.Status }</option>
									} else {
										<option value={ run.ID }>{ ShortID(run.ID) } · { run.Lab } · { run.Status }</option>
									}
								}
							</select>
						</div>
						<button type="submit" class="rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground">Compare</button>
					</form>
				</div>
			</div>
			if p.Err != "" {
				@box.Box(box.BoxProps{Class: "rounded-lg border border-destructive bg-destructive/10 p-4 text-sm text-destructive mb-4"}) {
					{ p.Err }
				}
			}
			if p.Diff != nil {
				<div class="lab-meta-strip">
					<div class="lab-meta-item">
						<div class="label">Status</div>
						<div class="value text-base">{ p.Diff.BaseStatus } → { p.Diff.HeadStatus }</div>
					</div>
					<div class="lab-meta-item">
						<div class="label">High</div>
						<div class="value">{ FormatInt(p.Diff.BaseSummary.High) } → { FormatInt(p.Diff.HeadSummary.High) }</div>
					</div>
					<div class="lab-meta-item">
						<div class="label">Delta</div>
						<div class="value text-base">+{ FormatInt(len(p.Diff.Added)) } / −{ FormatInt(len(p.Diff.Removed)) } / ~{ FormatInt(len(p.Diff.Changed)) }</div>
					</div>
					<div class="lab-meta-item">
						<div class="label">Unchanged</div>
						<div class="value">{ FormatInt(p.Diff.SameCount) }</div>
					</div>
				</div>
				<div class="lab-split">
					if len(p.Diff.Added) > 0 {
						<section class="lab-panel">
							<div class="lab-panel-head"><h2>Added in head</h2></div>
							<div class="lab-panel-body space-y-2">
								for _, f := range p.Diff.Added {
									@text.Text(text.TextProps{Class: "text-sm font-mono block"}) {
										{ string(f.Severity) } · { f.Code } — { f.Message }
									}
								}
							</div>
						</section>
					}
					if len(p.Diff.Removed) > 0 {
						<section class="lab-panel">
							<div class="lab-panel-head"><h2>Removed since base</h2></div>
							<div class="lab-panel-body space-y-2">
								for _, f := range p.Diff.Removed {
									@text.Text(text.TextProps{Class: "text-sm font-mono block"}) {
										{ string(f.Severity) } · { f.Code } — { f.Message }
									}
								}
							</div>
						</section>
					}
				</div>
				if len(p.Diff.Changed) > 0 {
					<section class="lab-panel mt-6">
						<div class="lab-panel-head"><h2>Changed</h2></div>
						<div class="lab-panel-body space-y-2">
							for _, c := range p.Diff.Changed {
								@text.Text(text.TextProps{Class: "text-sm font-mono block"}) {
									{ c.Base.Code }: { string(c.Base.Severity) } → { string(c.Head.Severity) }
								}
							}
						</div>
					</section>
				}
				<div class="lab-actions mt-4">
					@link.Link(link.LinkProps{Href: p.APIBase + "/v1/runs/compare?base=" + p.BaseID + "&head=" + p.HeadID + "&format=md", Variant: "default"}) {
						Download compare Markdown
					}
				</div>
			}
		}
	}
}
