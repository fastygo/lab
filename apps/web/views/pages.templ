package views

import (
	uiutils "github.com/ui8kit/ui/utils"
	"github.com/ui8kit/ui/ui/badge"
	"github.com/ui8kit/ui/ui/block"
	"github.com/ui8kit/ui/ui/box"
	"github.com/ui8kit/ui/ui/card"
	"github.com/ui8kit/ui/ui/container"
	"github.com/ui8kit/ui/ui/grid"
	"github.com/ui8kit/ui/ui/group"
	"github.com/ui8kit/ui/ui/link"
	"github.com/ui8kit/ui/ui/separator"
	"github.com/ui8kit/ui/ui/stack"
	"github.com/ui8kit/ui/ui/table"
	"github.com/ui8kit/ui/ui/text"
	"github.com/ui8kit/ui/ui/title"
)

templ Layout(titleText string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ titleText } · FastyGo Lab</title>
			<link rel="stylesheet" href="/static/css/app.css"/>
		</head>
		<body class="bg-background text-foreground antialiased">
			{ children... }
		</body>
	</html>
}

templ Shell(apiBase string) {
	@block.Block(block.BlockProps{Tag: "main", Class: "min-h-screen bg-muted/30"}) {
		@container.Container(container.ContainerProps{Class: "mx-auto max-w-6xl px-4 py-10"}) {
			@stack.Stack(stack.StackProps{Class: "gap-8"}) {
				@stack.Stack(stack.StackProps{Class: "gap-2"}) {
					@group.Group(group.GroupProps{Class: "items-center justify-between gap-4"}) {
						@link.Link(link.LinkProps{Href: "/", Variant: "default", Class: "no-underline"}) {
							@title.Title(title.TitleProps{As: uiutils.H1, Class: "text-2xl font-bold tracking-tight"}) {
								FastyGo Lab
							}
						}
						@badge.Badge(badge.BadgeProps{Variant: "outline", Class: "text-xs uppercase tracking-wide"}) {
							Cycle F3
						}
					}
					@text.Text(text.TextProps{Class: "text-sm text-muted-foreground"}) {
						Runs · reports · timelines — API { apiBase }
					}
				}
				{ children... }
			}
		}
	}
}

templ RunsPage(p RunsPageProps) {
	@Layout("Runs") {
		@Shell(p.APIBase) {
			@stack.Stack(stack.StackProps{Class: "gap-4"}) {
					@group.Group(group.GroupProps{Class: "items-center justify-between gap-3"}) {
					@title.Title(title.TitleProps{As: uiutils.H2, Class: "text-lg font-semibold"}) {
						Runs
					}
					@group.Group(group.GroupProps{Class: "gap-2 text-sm"}) {
						@link.Link(link.LinkProps{Href: "/compare", Variant: "default"}) {
							compare
						}
						@link.Link(link.LinkProps{Href: "/", Variant: "default"}) {
							all
						}
						@link.Link(link.LinkProps{Href: "/?lab=quality", Variant: "default"}) {
							quality
						}
						@link.Link(link.LinkProps{Href: "/?lab=org", Variant: "default"}) {
							org
						}
						@link.Link(link.LinkProps{Href: "/?lab=sec", Variant: "default"}) {
							sec
						}
					}
				}
				if p.Err != "" {
					@box.Box(box.BoxProps{Class: "rounded-lg border border-destructive bg-destructive/10 p-4 text-sm text-destructive"}) {
						{ p.Err }
					}
				}
				@card.Card(card.CardProps{Variant: "default"}) {
					@card.CardContent(card.CardContentProps{Class: "p-0 overflow-x-auto"}) {
						if len(p.Runs) == 0 && p.Err == "" {
							@box.Box(box.BoxProps{Class: "p-6"}) {
								@text.Text(text.TextProps{Class: "text-sm text-muted-foreground"}) {
									No runs yet. POST /v1/runs on the API, then refresh.
								}
							}
						} else {
							@table.Table(table.TableProps{Class: "w-full text-sm"}) {
								@table.TableHead(table.TableHeadProps{}) {
									@table.TableRow(table.TableRowProps{}) {
										@table.TableHeadCell(table.TableHeadCellProps{Scope: "col", Class: "px-4 py-3 text-left"}) {
											ID
										}
										@table.TableHeadCell(table.TableHeadCellProps{Scope: "col", Class: "px-4 py-3 text-left"}) {
											Lab
										}
										@table.TableHeadCell(table.TableHeadCellProps{Scope: "col", Class: "px-4 py-3 text-left"}) {
											Status
										}
										@table.TableHeadCell(table.TableHeadCellProps{Scope: "col", Class: "px-4 py-3 text-left"}) {
											Started
										}
										@table.TableHeadCell(table.TableHeadCellProps{Scope: "col", Class: "px-4 py-3 text-left"}) {
											Duration
										}
										@table.TableHeadCell(table.TableHeadCellProps{Scope: "col", Class: "px-4 py-3 text-left"}) {
											
										}
									}
								}
								@table.TableBody(table.TableBodyProps{}) {
									for _, run := range p.Runs {
										@table.TableRow(table.TableRowProps{Class: "border-t border-border"}) {
											@table.TableCell(table.TableCellProps{Class: "px-4 py-3 font-mono text-xs"}) {
												{ ShortID(run.ID) }
											}
											@table.TableCell(table.TableCellProps{Class: "px-4 py-3"}) {
												{ run.Lab }
											}
											@table.TableCell(table.TableCellProps{Class: "px-4 py-3"}) {
												@badge.Badge(badge.BadgeProps{Variant: StatusVariant(run.Status), Size: "sm"}) {
													{ run.Status }
												}
											}
											@table.TableCell(table.TableCellProps{Class: "px-4 py-3 text-muted-foreground"}) {
												{ FormatPtrTime(run.StartedAt) }
											}
											@table.TableCell(table.TableCellProps{Class: "px-4 py-3 text-muted-foreground"}) {
												{ Duration(run.StartedAt, run.FinishedAt) }
											}
											@table.TableCell(table.TableCellProps{Class: "px-4 py-3"}) {
												@link.Link(link.LinkProps{Href: "/runs/" + run.ID, Variant: "default"}) {
													open
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}
}

templ RunDetailPage(p RunDetailProps) {
	@Layout("Run " + ShortID(p.Run.ID)) {
		@Shell(p.APIBase) {
			@stack.Stack(stack.StackProps{Class: "gap-6"}) {
				@group.Group(group.GroupProps{Class: "items-center gap-3"}) {
					@link.Link(link.LinkProps{Href: "/", Variant: "default"}) {
						← runs
					}
					@badge.Badge(badge.BadgeProps{Variant: StatusVariant(p.Run.Status)}) {
						{ p.Run.Status }
					}
					@text.Text(text.TextProps{Class: "font-mono text-xs text-muted-foreground"}) {
						{ p.Run.ID }
					}
				}
				if p.Err != "" {
					@box.Box(box.BoxProps{Class: "rounded-lg border border-destructive bg-destructive/10 p-4 text-sm text-destructive"}) {
						{ p.Err }
					}
				}
				@grid.Grid(grid.GridProps{Cols: "1-3", Class: "gap-4"}) {
					@card.Card(card.CardProps{Variant: "muted"}) {
						@card.CardHeader(card.CardHeaderProps{}) {
							@card.CardTitle(card.CardTitleProps{}) {
								Lab
							}
						}
						@card.CardContent(card.CardContentProps{}) {
							@text.Text(text.TextProps{Class: "text-lg font-semibold"}) {
								{ p.Run.Lab }
							}
						}
					}
					@card.Card(card.CardProps{Variant: "muted"}) {
						@card.CardHeader(card.CardHeaderProps{}) {
							@card.CardTitle(card.CardTitleProps{}) {
								Duration
							}
						}
						@card.CardContent(card.CardContentProps{}) {
							@text.Text(text.TextProps{Class: "text-lg font-semibold"}) {
								{ Duration(p.Run.StartedAt, p.Run.FinishedAt) }
							}
						}
					}
					@card.Card(card.CardProps{Variant: "muted"}) {
						@card.CardHeader(card.CardHeaderProps{}) {
							@card.CardTitle(card.CardTitleProps{}) {
								Findings
							}
						}
						@card.CardContent(card.CardContentProps{}) {
							if p.Run.Summary != nil {
								@text.Text(text.TextProps{Class: "text-lg font-semibold"}) {
									{ FormatInt(p.Run.Summary.Total) } total · H{ FormatInt(p.Run.Summary.High) } M{ FormatInt(p.Run.Summary.Medium) }
								}
							} else if p.Report != nil {
								@text.Text(text.TextProps{Class: "text-lg font-semibold"}) {
									{ FormatInt(p.Report.Summary.Total) } total
								}
							} else {
								@text.Text(text.TextProps{Class: "text-sm text-muted-foreground"}) {
									—
								}
							}
						}
					}
				}
				if len(p.Baskets) > 0 {
					@card.Card(card.CardProps{Variant: "default"}) {
						@card.CardHeader(card.CardHeaderProps{}) {
							@card.CardTitle(card.CardTitleProps{}) {
								Decision baskets
							}
						}
						@card.CardContent(card.CardContentProps{}) {
							@group.Group(group.GroupProps{Class: "flex-wrap gap-2"}) {
								for _, b := range p.Baskets {
									@badge.Badge(badge.BadgeProps{Variant: "secondary"}) {
										{ b.Basket }: { FormatInt(b.Count) }
									}
								}
							}
						}
					}
				}
				@card.Card(card.CardProps{Variant: "default"}) {
					@card.CardHeader(card.CardHeaderProps{}) {
						@group.Group(group.GroupProps{Class: "items-center gap-3"}) {
							@card.CardTitle(card.CardTitleProps{}) {
								Timeline
							}
							if p.Live {
								<span id="live-badge" class="inline-flex items-center rounded-md border px-2 py-0.5 text-xs uppercase tracking-wide text-muted-foreground">live</span>
							}
						}
					}
					@card.CardContent(card.CardContentProps{}) {
						<div id="timeline" class="flex flex-col gap-3">
							if len(p.Events) == 0 {
								<p id="timeline-empty" class="text-sm text-muted-foreground">No events yet — waiting for worker…</p>
							} else {
								for _, ev := range p.Events {
									@group.Group(group.GroupProps{Class: "items-start gap-3 timeline-row"}) {
										@badge.Badge(badge.BadgeProps{Variant: "outline", Size: "sm", Class: "shrink-0 font-mono"}) {
											{ string(ev.Type) }
										}
										@stack.Stack(stack.StackProps{Class: "gap-0.5 min-w-0"}) {
											@text.Text(text.TextProps{Class: "text-sm"}) {
												{ EventLabel(ev) }
											}
											@text.Text(text.TextProps{Class: "text-xs text-muted-foreground"}) {
												{ FormatTime(ev.TS) }
											}
										}
									}
								}
							}
						</div>
					}
				}
				if p.Live {
					<script>
						(function () {
							const id = { templ.JSStr(p.Run.ID) };
							let n = { len(p.Events) };
							const root = document.getElementById("timeline");
							const badge = document.getElementById("live-badge");
							const es = new EventSource("/runs/" + id + "/live?after=" + n);
							function label(ev) {
								if (ev.check) return (ev.gate || "") + " · " + ev.check;
								if (ev.gate) return ev.gate;
								if (ev.adapter) return (ev.adapter + " " + (ev.baseUrl || "")).trim();
								if (ev.error) return ev.error;
								return ev.lab || "";
							}
							function append(ev) {
								const empty = document.getElementById("timeline-empty");
								if (empty) empty.remove();
								const row = document.createElement("div");
								row.className = "flex items-start gap-3 timeline-row";
								const type = document.createElement("div");
								type.className = "inline-flex items-center rounded-md border px-2 py-0.5 text-xs font-mono shrink-0";
								type.textContent = ev.type || "";
								const col = document.createElement("div");
								col.className = "flex flex-col gap-0.5 min-w-0";
								const msg = document.createElement("div");
								msg.className = "text-sm";
								msg.textContent = label(ev);
								const ts = document.createElement("div");
								ts.className = "text-xs text-muted-foreground";
								ts.textContent = ev.ts || "";
								col.appendChild(msg);
								col.appendChild(ts);
								row.appendChild(type);
								row.appendChild(col);
								root.appendChild(row);
								n++;
							}
							es.addEventListener("event", function (e) {
								try { append(JSON.parse(e.data)); } catch (_) {}
							});
							es.addEventListener("status", function (e) {
								try {
									const st = JSON.parse(e.data);
									if (badge) badge.textContent = st.status || "live";
								} catch (_) {}
							});
							es.addEventListener("done", function () {
								if (badge) badge.textContent = "done";
								es.close();
								setTimeout(function () { location.reload(); }, 800);
							});
							es.onerror = function () {
								if (badge) badge.textContent = "reconnect…";
							};
						})();
					</script>
				}
				@card.Card(card.CardProps{Variant: "default"}) {
					@card.CardHeader(card.CardHeaderProps{}) {
						@card.CardTitle(card.CardTitleProps{}) {
							Findings
						}
					}
					@card.CardContent(card.CardContentProps{Class: "p-0 overflow-x-auto"}) {
						if p.Report == nil || len(p.Report.Findings) == 0 {
							@box.Box(box.BoxProps{Class: "p-6"}) {
								@text.Text(text.TextProps{Class: "text-sm text-muted-foreground"}) {
									Report not ready or empty.
								}
							}
						} else {
							@table.Table(table.TableProps{Class: "w-full text-sm"}) {
								@table.TableHead(table.TableHeadProps{}) {
									@table.TableRow(table.TableRowProps{}) {
										@table.TableHeadCell(table.TableHeadCellProps{Scope: "col", Class: "px-4 py-3 text-left"}) {
											Sev
										}
										@table.TableHeadCell(table.TableHeadCellProps{Scope: "col", Class: "px-4 py-3 text-left"}) {
											Code
										}
										@table.TableHeadCell(table.TableHeadCellProps{Scope: "col", Class: "px-4 py-3 text-left"}) {
											Gate
										}
										@table.TableHeadCell(table.TableHeadCellProps{Scope: "col", Class: "px-4 py-3 text-left"}) {
											Message
										}
									}
								}
								@table.TableBody(table.TableBodyProps{}) {
									for _, f := range p.Report.Findings {
										if string(f.Severity) != "info" {
											@table.TableRow(table.TableRowProps{Class: "border-t border-border align-top"}) {
												@table.TableCell(table.TableCellProps{Class: "px-4 py-2"}) {
													@badge.Badge(badge.BadgeProps{Variant: SeverityVariant(f.Severity), Size: "sm"}) {
														{ string(f.Severity) }
													}
												}
												@table.TableCell(table.TableCellProps{Class: "px-4 py-2 font-mono text-xs"}) {
													{ f.Code }
												}
												@table.TableCell(table.TableCellProps{Class: "px-4 py-2 text-muted-foreground"}) {
													{ f.Gate }
												}
												@table.TableCell(table.TableCellProps{Class: "px-4 py-2"}) {
													{ f.Message }
												}
											}
										}
									}
								}
							}
							@separator.Separator(separator.SeparatorProps{Class: "my-0"})
							@box.Box(box.BoxProps{Class: "px-4 py-3"}) {
								@group.Group(group.GroupProps{Class: "flex-wrap gap-4"}) {
									@link.Link(link.LinkProps{Href: p.APIBase + "/v1/runs/" + p.Run.ID + "/report", Variant: "default", Class: "text-sm"}) {
										Download JSON
									}
									@link.Link(link.LinkProps{Href: p.APIBase + "/v1/runs/" + p.Run.ID + "/report.md", Variant: "default", Class: "text-sm"}) {
										Download Markdown
									}
									@link.Link(link.LinkProps{Href: "/compare?head=" + p.Run.ID, Variant: "default", Class: "text-sm"}) {
										Compare…
									}
								}
							}
						}
					}
				}
			}
		}
	}
}
