package views

import (
	"github.com/ui8kit/ui/ui/badge"
	"github.com/ui8kit/ui/ui/box"
	"github.com/ui8kit/ui/ui/group"
	"github.com/ui8kit/ui/ui/link"
	"github.com/ui8kit/ui/ui/table"
	"github.com/ui8kit/ui/ui/text"
)

templ Layout(titleText string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ titleText } · FastyGo Lab</title>
			<link rel="stylesheet" href="/static/css/app.css"/>
			<link rel="stylesheet" href="/static/css/lab.css"/>
		</head>
		<body class="bg-background text-foreground antialiased">
			{ children... }
		</body>
	</html>
}

templ Shell(apiBase string, active string) {
	<div class="lab-shell">
		<header class="lab-topbar">
			<div class="lab-frame" style="padding-block:0.85rem;">
				<div class="flex flex-wrap items-center justify-between gap-3">
					<a class="lab-brand" href="/">Fasty<span>Go</span> Lab</a>
					<nav class="lab-nav flex flex-wrap items-center gap-4">
						if active == "runs" {
							<a class="is-active" href="/">Runs</a>
						} else {
							<a href="/">Runs</a>
						}
						if active == "compare" {
							<a class="is-active" href="/compare">Compare</a>
						} else {
							<a href="/compare">Compare</a>
						}
						<a href={ apiBase + "/healthz" } target="_blank" rel="noreferrer">API</a>
						<span class="lab-mono hidden md:inline">{ apiBase }</span>
					</nav>
				</div>
			</div>
		</header>
		<div class="lab-frame">
			{ children... }
		</div>
	</div>
}

templ RunsPage(p RunsPageProps) {
	@Layout("Runs") {
		@Shell(p.APIBase, "runs") {
			<div class="lab-hero">
				<div>
					<p class="lab-kicker">Job history</p>
					<h1 class="lab-run-title">Runs</h1>
					@text.Text(text.TextProps{Class: "mt-2 text-sm text-muted-foreground"}) {
						Lab jobs from the API — status, duration, and reports.
					}
				</div>
				<div class="lab-filters">
					if p.Lab == "" {
						<a class="is-active" href="/">all</a>
					} else {
						<a href="/">all</a>
					}
					if p.Lab == "quality" {
						<a class="is-active" href="/?lab=quality">quality</a>
					} else {
						<a href="/?lab=quality">quality</a>
					}
					if p.Lab == "org" {
						<a class="is-active" href="/?lab=org">org</a>
					} else {
						<a href="/?lab=org">org</a>
					}
					if p.Lab == "sec" {
						<a class="is-active" href="/?lab=sec">sec</a>
					} else {
						<a href="/?lab=sec">sec</a>
					}
					if p.Lab == "demo" {
						<a class="is-active" href="/?lab=demo">demo</a>
					} else {
						<a href="/?lab=demo">demo</a>
					}
				</div>
			</div>
			if p.Err != "" {
				@box.Box(box.BoxProps{Class: "rounded-lg border border-destructive bg-destructive/10 p-4 text-sm text-destructive mb-4"}) {
					{ p.Err }
				}
			}
			<div class="lab-panel">
				<div class="lab-panel-head">
					<h2>Recent jobs</h2>
					@link.Link(link.LinkProps{Href: "/compare", Variant: "default", Class: "text-sm"}) {
						Compare runs
					}
				</div>
				<div class="overflow-x-auto">
					if len(p.Runs) == 0 && p.Err == "" {
						@box.Box(box.BoxProps{Class: "p-8"}) {
							@text.Text(text.TextProps{Class: "text-sm text-muted-foreground"}) {
								No runs yet. POST /v1/runs on the API, then refresh.
							}
						}
					} else {
						@table.Table(table.TableProps{Class: "w-full text-sm"}) {
							@table.TableHead(table.TableHeadProps{}) {
								@table.TableRow(table.TableRowProps{}) {
									@table.TableHeadCell(table.TableHeadCellProps{Scope: "col", Class: "px-4 py-3 text-left"}) {
										ID
									}
									@table.TableHeadCell(table.TableHeadCellProps{Scope: "col", Class: "px-4 py-3 text-left"}) {
										Lab
									}
									@table.TableHeadCell(table.TableHeadCellProps{Scope: "col", Class: "px-4 py-3 text-left"}) {
										Status
									}
									@table.TableHeadCell(table.TableHeadCellProps{Scope: "col", Class: "px-4 py-3 text-left"}) {
										Started
									}
									@table.TableHeadCell(table.TableHeadCellProps{Scope: "col", Class: "px-4 py-3 text-left"}) {
										Duration
									}
									@table.TableHeadCell(table.TableHeadCellProps{Scope: "col", Class: "px-4 py-3 text-left"}) {
										
									}
								}
							}
							@table.TableBody(table.TableBodyProps{}) {
								for _, run := range p.Runs {
									@table.TableRow(table.TableRowProps{Class: "border-t border-border hover:bg-muted/40"}) {
										@table.TableCell(table.TableCellProps{Class: "px-4 py-3 font-mono text-xs"}) {
											{ ShortID(run.ID) }
										}
										@table.TableCell(table.TableCellProps{Class: "px-4 py-3 font-medium"}) {
											{ run.Lab }
										}
										@table.TableCell(table.TableCellProps{Class: "px-4 py-3"}) {
											@badge.Badge(badge.BadgeProps{Variant: StatusVariant(run.Status), Size: "sm"}) {
												{ run.Status }
											}
										}
										@table.TableCell(table.TableCellProps{Class: "px-4 py-3 text-muted-foreground"}) {
											{ FormatPtrTime(run.StartedAt) }
										}
										@table.TableCell(table.TableCellProps{Class: "px-4 py-3 text-muted-foreground"}) {
											{ Duration(run.StartedAt, run.FinishedAt) }
										}
										@table.TableCell(table.TableCellProps{Class: "px-4 py-3"}) {
											@link.Link(link.LinkProps{Href: "/runs/" + run.ID, Variant: "default"}) {
												Open
											}
										}
									}
								}
							}
						}
					}
				</div>
			</div>
		}
	}
}

templ RunDetailPage(p RunDetailProps) {
	@Layout("Run " + ShortID(p.Run.ID)) {
		@Shell(p.APIBase, "runs") {
			if p.Err != "" {
				@box.Box(box.BoxProps{Class: "rounded-lg border border-destructive bg-destructive/10 p-4 text-sm text-destructive mb-4"}) {
					{ p.Err }
				}
			}
			<div class="lab-hero">
				<div>
					<p class="lab-kicker">
						@link.Link(link.LinkProps{Href: "/", Variant: "default", Class: "text-muted-foreground"}) {
							Runs
						}
						{" / "}{ p.Run.Lab }
					</p>
					<div class="mt-2 flex flex-wrap items-center gap-3">
						<h1 class="lab-run-title">{ p.Run.Lab }</h1>
						@badge.Badge(badge.BadgeProps{Variant: StatusVariant(p.Run.Status)}) {
							{ p.Run.Status }
						}
						if p.Live {
							<span id="live-badge" class="inline-flex items-center rounded-md border px-2 py-0.5 text-xs uppercase tracking-wide text-muted-foreground">live</span>
						}
					</div>
					<p class="lab-mono mt-2">{ p.Run.ID }</p>
				</div>
				@group.Group(group.GroupProps{Class: "gap-3"}) {
					@link.Link(link.LinkProps{Href: p.APIBase + "/v1/runs/" + p.Run.ID + "/report.md", Variant: "default", Class: "text-sm"}) {
						Markdown
					}
					@link.Link(link.LinkProps{Href: p.APIBase + "/v1/runs/" + p.Run.ID + "/report", Variant: "default", Class: "text-sm"}) {
						JSON
					}
					@link.Link(link.LinkProps{Href: "/compare?head=" + p.Run.ID, Variant: "default", Class: "text-sm"}) {
						Compare
					}
				}
			</div>
			<div class="lab-meta-strip">
				<div class="lab-meta-item">
					<div class="label">Lab</div>
					<div class="value">{ p.Run.Lab }</div>
				</div>
				<div class="lab-meta-item">
					<div class="label">Duration</div>
					<div class="value">{ Duration(p.Run.StartedAt, p.Run.FinishedAt) }</div>
				</div>
				<div class="lab-meta-item">
					<div class="label">Findings</div>
					<div class="value">
						if p.Run.Summary != nil {
							{ FormatInt(p.Run.Summary.Total) } · H{ FormatInt(p.Run.Summary.High) } M{ FormatInt(p.Run.Summary.Medium) }
						} else if p.Report != nil {
							{ FormatInt(p.Report.Summary.Total) } total
						} else {
							—
						}
					</div>
				</div>
				<div class="lab-meta-item">
					<div class="label">Baskets</div>
					<div class="value flex flex-wrap gap-2">
						if len(p.Baskets) == 0 {
							<span class="text-muted-foreground font-normal text-sm">—</span>
						} else {
							for _, b := range p.Baskets {
								@badge.Badge(badge.BadgeProps{Variant: "secondary", Size: "sm"}) {
									{ b.Basket } { FormatInt(b.Count) }
								}
							}
						}
					</div>
				</div>
			</div>
			<div class="lab-split">
				<section class="lab-panel">
					<div class="lab-panel-head">
						<h2>Timeline</h2>
						<span class="lab-mono">{ FormatInt(len(p.Events)) } events</span>
					</div>
					<div class="lab-panel-body" id="timeline">
						if len(p.Events) == 0 {
							<p id="timeline-empty" class="text-sm text-muted-foreground py-4">No events yet — waiting for worker…</p>
						} else {
							for _, ev := range p.Events {
								<div class="lab-timeline-row">
									<div class="lab-timeline-type">{ string(ev.Type) }</div>
									<div>
										<div class="text-sm">{ EventLabel(ev) }</div>
										<div class="text-xs text-muted-foreground mt-0.5">{ FormatTime(ev.TS) }</div>
									</div>
								</div>
							}
						}
					</div>
				</section>
				<section class="lab-panel">
					<div class="lab-panel-head">
						<h2>Findings</h2>
						if p.Report != nil {
							<span class="lab-mono">{ string(p.Report.Status) }</span>
						}
					</div>
					if p.Report == nil || len(p.Report.Findings) == 0 {
						@box.Box(box.BoxProps{Class: "p-8"}) {
							@text.Text(text.TextProps{Class: "text-sm text-muted-foreground"}) {
								Report not ready or no non-info findings.
							}
						}
					} else {
						<div class="overflow-x-auto">
							@table.Table(table.TableProps{Class: "w-full text-sm"}) {
								@table.TableHead(table.TableHeadProps{}) {
									@table.TableRow(table.TableRowProps{}) {
										@table.TableHeadCell(table.TableHeadCellProps{Scope: "col", Class: "px-4 py-3 text-left"}) {
											Sev
										}
										@table.TableHeadCell(table.TableHeadCellProps{Scope: "col", Class: "px-4 py-3 text-left"}) {
											Code
										}
										@table.TableHeadCell(table.TableHeadCellProps{Scope: "col", Class: "px-4 py-3 text-left"}) {
											Gate
										}
										@table.TableHeadCell(table.TableHeadCellProps{Scope: "col", Class: "px-4 py-3 text-left"}) {
											Message
										}
									}
								}
								@table.TableBody(table.TableBodyProps{}) {
									for _, f := range p.Report.Findings {
										if string(f.Severity) != "info" {
											@table.TableRow(table.TableRowProps{Class: "border-t border-border align-top"}) {
												@table.TableCell(table.TableCellProps{Class: "px-4 py-2"}) {
													@badge.Badge(badge.BadgeProps{Variant: SeverityVariant(f.Severity), Size: "sm"}) {
														{ string(f.Severity) }
													}
												}
												@table.TableCell(table.TableCellProps{Class: "px-4 py-2 font-mono text-xs"}) {
													{ f.Code }
												}
												@table.TableCell(table.TableCellProps{Class: "px-4 py-2 text-muted-foreground"}) {
													{ f.Gate }
												}
												@table.TableCell(table.TableCellProps{Class: "px-4 py-2"}) {
													{ f.Message }
												}
											}
										}
									}
								}
							}
						</div>
						<div class="lab-actions">
							@link.Link(link.LinkProps{Href: p.APIBase + "/v1/runs/" + p.Run.ID + "/report", Variant: "default"}) {
								Download JSON
							}
							@link.Link(link.LinkProps{Href: p.APIBase + "/v1/runs/" + p.Run.ID + "/report.md", Variant: "default"}) {
								Download Markdown
							}
							@link.Link(link.LinkProps{Href: "/compare?head=" + p.Run.ID, Variant: "default"}) {
								Compare with another run
							}
						</div>
					}
				</section>
			</div>
			if p.Live {
				<script>
					(function () {
						const id = { templ.JSStr(p.Run.ID) };
						let n = { len(p.Events) };
						const root = document.getElementById("timeline");
						const badge = document.getElementById("live-badge");
						const es = new EventSource("/runs/" + id + "/live?after=" + n);
						function label(ev) {
							if (ev.check) return (ev.gate || "") + " · " + ev.check;
							if (ev.gate) return ev.gate;
							if (ev.adapter) return (ev.adapter + " " + (ev.baseUrl || "")).trim();
							if (ev.error) return ev.error;
							return ev.lab || "";
						}
						function append(ev) {
							const empty = document.getElementById("timeline-empty");
							if (empty) empty.remove();
							const row = document.createElement("div");
							row.className = "lab-timeline-row";
							const type = document.createElement("div");
							type.className = "lab-timeline-type";
							type.textContent = ev.type || "";
							const col = document.createElement("div");
							const msg = document.createElement("div");
							msg.className = "text-sm";
							msg.textContent = label(ev);
							const ts = document.createElement("div");
							ts.className = "text-xs text-muted-foreground mt-0.5";
							ts.textContent = ev.ts || "";
							col.appendChild(msg);
							col.appendChild(ts);
							row.appendChild(type);
							row.appendChild(col);
							root.appendChild(row);
							n++;
						}
						es.addEventListener("event", function (e) {
							try { append(JSON.parse(e.data)); } catch (_) {}
						});
						es.addEventListener("status", function (e) {
							try {
								const st = JSON.parse(e.data);
								if (badge) badge.textContent = st.status || "live";
							} catch (_) {}
						});
						es.addEventListener("done", function () {
							if (badge) badge.textContent = "done";
							es.close();
							setTimeout(function () { location.reload(); }, 800);
						});
						es.onerror = function () {
							if (badge) badge.textContent = "reconnect…";
						};
					})();
				</script>
			}
		}
	}
}
