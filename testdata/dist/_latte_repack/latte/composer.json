{
  "name": "godudy/latte",
  "description": "Latte — WP FastY theme with vendored UI8Kit Latte primitives",
  "type": "wordpress-theme",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.2",
    "latte/latte": "^3.0",
    "ui8kit/latte-primitives": "@dev"
  },
  "repositories": [
    {
      "type": "path",
      "url": "lib/ui8kit-latte",
      "options": {
        "symlink": false
      }
    }
  ],
  "autoload": {
    "psr-4": {
      "WPFasty\\": "classes/"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "platform": {
      "php": "8.2"
    }
  }
}
