# Public WordPress URL used in HTML asset links (WP_HOME / WP_SITEURL).
# Local Docker Desktop:
# LAB_WP_URL=http://127.0.0.1:8080
#
# Remote lab server (example):
LAB_WP_URL=http://5.129.242.217:8080

# Cycle F — Postgres connection URI (pgx; same style as Supabase "Database URL")
# Local compose --profile saas:
# LAB_DATABASE_URL=postgres://lab:lab@127.0.0.1:5432/lab?sslmode=disable
# Supabase (Settings → Database → Connection string / URI):
# DATABASE_URL=postgres://postgres.[ref]:[password]@aws-0-….pooler.supabase.com:6543/postgres?sslmode=require
# LAB_PG_PORT=5432

# Owned-target allowlist for wordpress adapter (sec/org/quality-wp jobs)
# LAB_ALLOWED_BASE_URLS=http://127.0.0.1:8080,http://5.129.242.217:8080

# F4 notify (optional)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# LAB_NOTIFY_ON=warn+fail
# LAB_DASHBOARD_URL=http://127.0.0.1:8091
